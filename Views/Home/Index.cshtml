@{
    ViewData["Title"] = "Care that feels close to home";
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <p class="eyebrow"><span></span> Your health, our priority</p>
                <h1>Better care begins with a <em>human touch.</em></h1>
                <p class="hero-copy">Amani Clinic brings together trusted doctors, simple appointment booking and thoughtful care—all in one welcoming place.</p>
                <div class="d-flex flex-wrap gap-3 mt-4"><a class="btn btn-primary btn-lg" href="#appointment">Book an appointment <span aria-hidden="true">→</span></a><a class="btn btn-outline-primary btn-lg" href="#services">Explore our services</a></div>
                <div class="trust-row"><div class="avatar-stack" aria-hidden="true"><span>AM</span><span>KN</span><span>SM</span></div><p><strong>5,000+ patients</strong><br />have trusted us with their care</p></div>
            </div>
            <div class="col-lg-6"><div class="hero-visual" role="img" aria-label="A caring doctor consulting with a patient"><div class="hero-orb orb-one"></div><div class="hero-orb orb-two"></div><div class="doctor-illustration"><div class="doctor-head"></div><div class="doctor-body"><span class="stethoscope">⌁</span></div></div><div class="floating-card appointment-card"><span class="mini-icon">✓</span><div><strong>Appointments made easy</strong><small>Choose a time that works for you</small></div></div><div class="floating-card rating-card"><span class="stars">★★★★★</span><strong>4.9 <small>patient rating</small></strong></div></div></div>
        </div>
    </div>
</section>

<section class="services-section" id="services">
    <div class="container">
        <div class="section-intro text-center"><p class="eyebrow justify-content-center"><span></span> How we can help</p><h2>Care designed around <em>you.</em></h2><p>Everything you need to look after your health, delivered with expertise and kindness.</p></div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3"><article class="service-card"><div class="service-icon icon-teal">♥</div><h3>Primary care</h3><p>Everyday health support for every stage of life.</p><a href="#appointment">Learn more <span>→</span></a></article></div>
            <div class="col-md-6 col-lg-3"><article class="service-card"><div class="service-icon icon-peach">⌁</div><h3>Specialist care</h3><p>Expert guidance when you need it most.</p><a href="#appointment">Learn more <span>→</span></a></article></div>
            <div class="col-md-6 col-lg-3"><article class="service-card"><div class="service-icon icon-blue">✚</div><h3>Health checks</h3><p>Stay ahead with proactive, preventive care.</p><a href="#appointment">Learn more <span>→</span></a></article></div>
            <div class="col-md-6 col-lg-3"><article class="service-card"><div class="service-icon icon-yellow">☏</div><h3>Online consultation</h3><p>Connect with a doctor from wherever you are.</p><a href="#appointment">Learn more <span>→</span></a></article></div>
        </div>
    </div>
</section>

<section class="appointment-section" id="appointment"><div class="container"><div class="appointment-panel"><div><p class="eyebrow"><span></span> Simple, convenient care</p><h2>Your next appointment is just a few clicks away.</h2><p>Find the right doctor and a time that suits your schedule.</p></div><a class="btn btn-light btn-lg" href="mailto:appointments@amaniclinic.co.za">Make an appointment <span aria-hidden="true">→</span></a></div></div></section>

<section class="team-section" id="care-team">
    <div class="container"><div class="row align-items-end mb-4"><div class="col-lg-7"><p class="eyebrow"><span></span> Meet your care team</p><h2>Experienced hands.<br /><em>Warm hearts.</em></h2></div><div class="col-lg-5"><p class="mb-0">Our dedicated team is here to listen, guide and care for you at every step.</p></div></div><div class="row g-4"><div class="col-md-4"><div class="team-card team-one"><div class="team-photo"><span>Dr</span></div><h3>Dr. Naledi Mokoena</h3><p>Family Medicine</p></div></div><div class="col-md-4"><div class="team-card team-two"><div class="team-photo"><span>Dr</span></div><h3>Dr. Ethan Williams</h3><p>General Practitioner</p></div></div><div class="col-md-4"><div class="team-card team-three"><div class="team-photo"><span>Dr</span></div><h3>Dr. Zinhle Dlamini</h3><p>Women's Health</p></div></div></div></div>
</section>
