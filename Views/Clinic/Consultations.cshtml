@model IEnumerable<AmaniClinic.Models.Consultation>
@using AmaniClinic.Models
@{ ViewData["Title"] = "Consultations"; var appointments = (IEnumerable<Appointment>)ViewBag.Appointments; }
<section class="portal-page"><div class="container"><div class="portal-title"><a asp-action="Index">← Clinic portal</a><h1>Consultation <em>records.</em></h1></div>
@if (TempData["Message"] is string message) { <div class="alert alert-success">@message</div> }
<div class="portal-card mb-4"><h2>Record consultation</h2><form asp-action="CreateConsultation" method="post" class="row g-3"><div class="col-md-6"><select name="AppointmentId" class="form-select" required><option value="">Select appointment</option>@foreach (var item in appointments) { <option value="@item.AppointmentId">@item.Patient.FirstName @item.Patient.LastName — @item.AppointmentDate.ToString("dd MMM yyyy")</option> }</select></div><div class="col-md-6"><input name="ConsultationDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div><div class="col-md-6"><textarea name="Symptoms" class="form-control" placeholder="Symptoms"></textarea></div><div class="col-md-6"><textarea name="Diagnosis" class="form-control" placeholder="Diagnosis"></textarea></div><div class="col-md-6"><textarea name="Treatment" class="form-control" placeholder="Treatment"></textarea></div><div class="col-md-6"><textarea name="Notes" class="form-control" placeholder="Clinical notes"></textarea></div><div class="col-12"><button class="btn btn-primary">Save consultation</button></div></form></div>
<div class="portal-card"><h2>Saved records</h2><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Patient</th><th>Date</th><th>Diagnosis</th><th>Treatment</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Appointment.Patient.FirstName @item.Appointment.Patient.LastName</td><td>@item.ConsultationDate.ToString("dd MMM yyyy")</td><td>@item.Diagnosis</td><td>@item.Treatment</td></tr> } @if (!Model.Any()) { <tr><td colspan="4" class="text-muted">No consultation records yet.</td></tr> }</tbody></table></div></div></div></section>
