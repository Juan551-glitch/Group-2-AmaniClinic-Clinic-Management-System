@model IEnumerable<AmaniClinic.Models.Appointment>
@{ ViewData["Title"] = "Appointments"; }
<section class="portal-page"><div class="container"><div class="portal-title"><a asp-action="Index">← Clinic portal</a><h1>Manage <em>appointments.</em></h1></div><div class="portal-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Patient</th><th>Doctor</th><th>Date & time</th><th>Reason</th><th>Status</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Patient.FirstName @item.Patient.LastName</td><td>@item.Doctor.DisplayName</td><td>@item.AppointmentDate.ToString("dd MMM yyyy") @item.AppointmentTime.ToString("HH:mm")</td><td>@item.Reason</td><td><form asp-action="UpdateAppointmentStatus" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@item.AppointmentId" /><select name="status" class="form-select form-select-sm"><option selected="@(item.Status == "Scheduled")">Scheduled</option><option selected="@(item.Status == "Completed")">Completed</option><option selected="@(item.Status == "Cancelled")">Cancelled</option></select><button class="btn btn-outline-primary btn-sm">Save</button></form></td></tr> } @if (!Model.Any()) { <tr><td colspan="5" class="text-muted">No appointments yet.</td></tr> }</tbody></table></div></div></div></section>
