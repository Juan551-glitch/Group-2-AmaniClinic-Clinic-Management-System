@model IEnumerable<AmaniClinic.Models.Appointment>
<div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Patient</th><th>Doctor</th><th>Date & time</th><th>Status</th><th>Reason</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Patient.FirstName @item.Patient.LastName</td><td>@item.Doctor.DisplayName</td><td>@item.AppointmentDate.ToString("dd MMM yyyy")<br /><small>@item.AppointmentTime.ToString("HH:mm")</small></td><td><span class="status-pill">@item.Status</span></td><td>@item.Reason</td></tr> }
@if (!Model.Any()) { <tr><td colspan="5" class="text-muted">No appointments yet.</td></tr> }
</tbody></table></div>
