@model IEnumerable<AmaniClinic.Models.Patient>
@{ ViewData["Title"] = "Patients"; }
<section class="portal-page"><div class="container"><div class="portal-title"><a asp-action="Index">← Clinic portal</a><h1>Manage <em>patients.</em></h1></div>
@if (TempData["Message"] is string message) { <div class="alert alert-success">@message</div> }
<div class="portal-card mb-4"><h2>Add patient</h2><form asp-action="CreatePatient" method="post" class="row g-3"><div class="col-md-4"><input name="FirstName" class="form-control" placeholder="First name" required /></div><div class="col-md-4"><input name="LastName" class="form-control" placeholder="Last name" required /></div><div class="col-md-4"><input name="DateOfBirth" type="date" class="form-control" required /></div><div class="col-md-4"><input name="Phone" class="form-control" placeholder="Phone" /></div><div class="col-md-4"><input name="Email" type="email" class="form-control" placeholder="Email" /></div><div class="col-md-4"><input name="Address" class="form-control" placeholder="Address" /></div><div class="col-12"><button class="btn btn-primary">Add patient</button></div></form></div>
<div class="portal-card"><h2>Patients</h2><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Name</th><th>Date of birth</th><th>Phone</th><th>Email</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.FirstName @item.LastName</td><td>@item.DateOfBirth.ToString("dd MMM yyyy")</td><td>@item.Phone</td><td>@item.Email</td></tr> } @if (!Model.Any()) { <tr><td colspan="4" class="text-muted">No patients yet.</td></tr> }</tbody></table></div></div>
</div></section>
