@model IEnumerable<AmaniClinic.Models.Appointment>
@{ ViewData["Title"] = "Clinic portal"; }
<section class="portal-page"><div class="container">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><p class="eyebrow"><span></span> Clinic management</p><h1>Clinic <em>portal.</em></h1></div><div class="portal-links"><a asp-action="Patients">Patients</a><a asp-action="Doctors">Doctors</a><a asp-action="Appointments">Appointments</a><a asp-action="Consultations">Consultations</a></div></div>
    <div class="row g-3 mb-5"><div class="col-6 col-lg-3"><div class="metric-card"><strong>@ViewBag.PatientCount</strong><span>Patients</span></div></div><div class="col-6 col-lg-3"><div class="metric-card"><strong>@ViewBag.DoctorCount</strong><span>Doctors</span></div></div><div class="col-6 col-lg-3"><div class="metric-card"><strong>@ViewBag.AppointmentCount</strong><span>Appointments</span></div></div><div class="col-6 col-lg-3"><div class="metric-card"><strong>@ViewBag.ConsultationCount</strong><span>Consultations</span></div></div></div>
    <div class="portal-card"><h2>Recent appointments</h2><partial name="_AppointmentTable" model="Model" /></div>
</div></section>
